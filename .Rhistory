powersLoop(x, 3)
powersLoop <- function(x, dg)
{
result <- matrix(0, nrow = length(x), ncol = dg)
for(i in 1:dg)
{
result[, i] <- x^i
}
return(result)
}
powersLoop(x, 3)
x <- c(1, 2, 3, 4, 5)
powersLoop(x, 3)
#3. Input: a numerical vector -> Output: the ordered vector
orderVector <- function(x)
{
n <- length(x)
for(j in 1:(n - 1))
{
for(i in (j + 1):n)
{
if (x[i] < x[j])
{
temp <- x[j]
x[j] <- x[i]
x[i] <- temp
}
}
}
return(x)
}
#Test
x <- c(7, 2, 9, 4, 1)
orderVector(x)
