#---------- Question 4 ----------#
#We examine the relationship between mileage and asking price
#for 22 Honda Civic listings from Craigslist.
library(readxl) #Read Excel files
library(ggplot2) #Create graphs
hondas <- read_excel("hondas-1.xlsx") #Import data
print(hondas) #Display the data
#Create a scatter plot of mileage versus price
ggplot(hondas, aes(x = Miles, y = price, color = type)) +
geom_point(size = 3) + #Display each Honda Civic
geom_smooth(method = "lm", se = FALSE) + #Add trend lines
labs(title = "Honda Civic Price vs Mileage",
x = "Mileage",
y = "Price ($)",
color = "Model Type") +
theme_minimal() #Use a clean graph theme
#The scatter plot shows that Honda Civics with higher mileage
#generally have lower asking prices.
#This suggests a negative relationship between mileage and price.
#EX models also appear to have higher asking prices than LX models
#in some comparable mileage ranges, although model year may
#also affect the relationship.
#One interesting listing is a 2016 LX with 9,000 miles
#priced at $11,500, while another 2016 LX with the same
#mileage is priced at $13,500.
#The cheaper listing may be a better deal if both vehicles
#have similar condition and maintenance history.
#I would recommend comparing mileage, model year, trim,
#and vehicle condition before purchasing rather than
#choosing a vehicle based only on price.
#1. The departure of the points from the 45* line doesn't necessarily indicate that the mystery
#-> distribution is not normal because it's slightly shifted which could indicate that it follows a normal
#-> distribution but one that has a different mean and standard deviation than the one from the line.
#2. Write a function that given a one dimensional data set or a vector, and the degrees of freedom
#-> dg, makes a qqplot of the data set versus a Student-t distribution with dg degrees of freedom.
#-> Use appropriate labels and title.
# first we need inputs which are: data set or vector (x) and degrees of freedom (dg)
# We want to identify what we want the function to do exactly:
# 1. turn (x) into a qqplot and compare with a t-dist with the (dg) from our input
# 2. How do we do that: compare the quantiles of (x) with t-dist using qt() and match them correctly by using
# -> sort() to sort our data
# 3. We also need to calculate the probability for each observation p[i] = (i-0.5)/n: n is the total # of obs
# 4. For each prob we need to calculate the theoretical t-dist quantile q[i] = qt(p[i], df = dg)
data_vsT <- function (x, dg) {
if (!is.numeric(x) || !is.numeric(dg)) return ("inputs must be numeric")
if (any(is.na(x))) return ("x must be complete")
if (dg <= 0) return ("dg must be positive and greater than zero")
x <- sort(x)
n <- length(x)
p <- numeric(n)
q <- numeric(n)
for (i in seq_along(x)) {
p[i] = (i-0.5)/n
q[i] = qt(p[i], df = dg)
}
qqplot(x = q, y = x, main = "Data vs T-Distribution", xlab = "T-distribution" , ylab = "data")
}
x <- rnorm(100)
data_vsT(x,5)
data_vsT(c(1, 2, NA, 4), 5)
data_vsT(c(1, 2, 3, 4), -2)
#3. Use qqplots to show the convergence of the binomial distribution to the Poisson distribution
lambda <- 5 # Setting the Poisson mean to 5
n_vals <- c(10,50,100,500) # Testing these multiple values of n for different samples sizes
par(mfrow = c(2,2)) # plotting them together on different plots
for (n in n_vals) {
p <- lambda/n
binom_quantiles <- qbinom(ppoints(100), size = n, prob = p)
poisson_quantiles <- qpois(ppoints(100), lambda= lambda)
qqplot(poisson_quantiles, binom_quantiles, main = paste("n=",n), xlab = "Poisson Quantiles", ylab =
"Binomial Quantiles")
abline(0, 1, col = "red", lwd = 2)
} # Here the code is calculating the binomial and poisson quantiles and comparing the 2 distributions
# abline is added to add a red reference line
# from this data we show that as n gets bigger the binomial distribution approaches a poisson distribution
# I made multiples plots to demonstrate the convergence better how distributions with bigger n approach
# -> more.
