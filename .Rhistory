#---------- MATH 167R Assignment 4 ----------#
#---------- Question 1 ----------#
#The departure from the 45-degree line does not necessarily mean
#that the mystery distribution is not normal.
#A normal distribution can have a different mean and standard deviation
#than the standard normal distribution, which has mean 0 and SD 1.
#The points appear to follow an approximately straight line,
#but the line is shifted upward and has a different slope.
#This suggests the mystery distribution could still be normal,
#just with a different mean and standard deviation.
#---------- Question 2 ----------#
#This function creates a QQ plot comparing a data vector
#against a Student-t distribution with dg degrees of freedom.
studentQQ <- function(x, dg)
{
n <- length(x) #Number of observations
p <- ppoints(n) #Generate probability points
theoretical <- qt(p, df = dg) #Student-t quantiles
qqplot(theoretical, x,
main = paste("Student-t QQ Plot (df =", dg, ")"),
xlab = "Theoretical Student-t Quantiles",
ylab = "Sample Quantiles",
pch = 19,
col = "blue")
#Add reference line based on the quartiles
sampleQ <- quantile(x, c(0.25, 0.75))
theoreticalQ <- qt(c(0.25, 0.75), df = dg)
slope <- diff(sampleQ) / diff(theoreticalQ)
intercept <- sampleQ[1] - slope * theoreticalQ[1]
abline(a = intercept, b = slope, col = "red", lty = 2)
}
#Test the function with a Student-t sample
set.seed(123) #Make results reproducible
x <- rt(100, df = 5) #Generate 100 Student-t values
studentQQ(x, 5) #Create QQ plot
#---------- Question 3 ----------#
#The binomial distribution approaches the Poisson distribution
#when n increases, p decreases, and n*p stays constant.
#We compare four binomial distributions against Poisson(5).
lambda <- 5 #Poisson mean
nValues <- c(10, 50, 100, 1000) #Different trial counts
par(mfrow = c(2, 2)) #Display four plots together
for (n in nValues)
{
p <- lambda / n #Keep n*p equal to lambda
probabilities <- ppoints(100) #Generate probability points
binomial <- qbinom(probabilities, size = n, prob = p)
poisson <- qpois(probabilities, lambda = lambda)
qqplot(poisson, binomial,
main = paste("n =", n, ", p =", p),
xlab = "Poisson Quantiles",
ylab = "Binomial Quantiles",
pch = 19,
col = "blue")
abline(0, 1, col = "red", lty = 2) #45-degree reference line
}
par(mfrow = c(1, 1)) #Reset plotting layout
#As n increases and p decreases, the binomial quantiles
#become more similar to the Poisson quantiles.
#The points move closer to the 45-degree line.
#This demonstrates convergence to the Poisson distribution.
#Some points overlap because both distributions are discrete.
