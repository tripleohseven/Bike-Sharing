#Load the MASS package and Cars93 dataset
library(MASS)
data(Cars93)
#Set up 2 rows and 3 columns for the plots
par(mfrow = c(2, 3))
#Assign a different color to each vehicle type
colors <- as.numeric(factor(Cars93$Type))
#Assign a different plotting symbol to each cylinder value
symbols <- as.numeric(factor(Cars93$Cylinders))
#---------- Row 1 ----------#
#Plot 1: Price versus Horsepower
plot(Cars93$Horsepower, Cars93$Price, col = colors, pch = symbols, xlab = "Horsepower", ylab = "Price")
#Plot 2: Price versus RPM
plot(Cars93$RPM, Cars93$Price, col = colors, pch = symbols, xlab = "RPM", ylab = "Price")
#Plot 3: Price versus Length
plot(Cars93$Length, Cars93$Price, col = colors, pch = symbols, xlab = "Length", ylab = "Price")
#---------- Row 2 ----------#
#Plot 4: Max.Price versus Horsepower
plot(Cars93$Horsepower, Cars93$Max.Price, col = colors, pch = symbols, xlab = "Horsepower", ylab = "Max.Price")
#Plot 5: Max.Price versus RPM
plot(Cars93$RPM, Cars93$Max.Price, col = colors, pch = symbols, xlab = "RPM", ylab = "Max.Price")
#Plot 6: Max.Price versus Length
plot(Cars93$Length, Cars93$Max.Price, col = colors, pch = symbols, xlab = "Length", ylab = "Max.Price")
